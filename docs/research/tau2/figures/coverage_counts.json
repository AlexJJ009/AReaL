        },
        {
          "tag": "certificate_payment",
          "label": "Certificate payment",
          "group": "Payment",
          "definition": "gold 实际支付或退款涉及 travel certificate。"
        },
        {
          "tag": "refuse_cancellation_ineligible",
          "label": "Cancellation ineligible",
          "group": "Refusal",
          "definition": "请求取消，但不满足 24h、商务舱、航司取消或保险承保理由之一。"
        },
        {
          "tag": "refuse_basic_economy_change",
          "label": "Basic economy restriction",
          "group": "Refusal",
          "definition": "请求直接修改 basic economy 航班，须先拒绝该修改路径。"
        },
        {
          "tag": "refuse_already_flown",
          "label": "Already flown restriction",
          "group": "Refusal",
          "definition": "请求取消已有已飞航段的预订或修改其 cabin，须说明限制或转人工。"
        },
        {
          "tag": "refuse_insurance_after_booking",
          "label": "Cannot add insurance",
          "group": "Refusal",
          "definition": "请求给已存在的预订追加保险，policy 禁止。"
        },
        {
          "tag": "refuse_route_change",
          "label": "Route change forbidden",
          "group": "Refusal",
          "definition": "请求直接改变 origin、destination 或 trip type，须拒绝直接修改。"
        },
        {
          "tag": "refuse_baggage_removal",
          "label": "Cannot remove baggage",
          "group": "Refusal",
          "definition": "请求减少已订托运行李，policy 只允许增加。"
        },
        {
          "tag": "refuse_compensation_ineligible",
          "label": "Compensation ineligible",
          "group": "Refusal",
          "definition": "请求或试探补偿，但不符合 policy 的补偿场景或资格。"
        },
        {
          "tag": "refuse_passenger_count",
          "label": "Passenger count fixed",
          "group": "Refusal",
          "definition": "请求增删已有预订乘客人数，policy 禁止。"
        },
        {
          "tag": "refuse_cabin_consistency",
          "label": "Uniform cabin required",
          "group": "Refusal",
          "definition": "请求只给部分航段或乘客改变 cabin，但同预订 cabin 必须一致。"
        },
        {
          "tag": "refuse_payment_restriction",
          "label": "Payment restriction",
          "group": "Refusal",
          "definition": "实际要求的支付方法或组合违反预订或修改支付规则。"
        },
        {
          "tag": "refuse_unsupported_fee_waiver",
          "label": "Unsupported fee waiver",
          "group": "Refusal",
